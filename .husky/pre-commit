#!/bin/sh
set -e

npx lint-staged   # secrets, format — always required
npm run arch:check

# WIP=1: skip heavy gates so you can commit on red
if [ "${WIP:-0}" = "1" ]; then
  exit 0
fi

npm run typecheck
npm run check:ac
npm run test:unit

if git diff --cached --name-only | grep -qE '^(src/|test/|package\.json|package-lock\.json)'; then
  npm run audit
fi
